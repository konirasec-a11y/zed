{
  "schema_version": 1,
  "id": "use_case-project",
  "name": "Use Case",
  "root_model": "root",
  "elements": [
    {
      "id": "root",
      "kind": "uml.model",
      "name": "Behavioral acceptance corpus",
      "properties": {}
    },
    {
      "id": "customer",
      "kind": "uml.actor",
      "name": "Customer",
      "properties": {}
    },
    {
      "id": "member",
      "kind": "uml.actor",
      "name": "Registered customer",
      "properties": {}
    },
    {
      "id": "gateway",
      "kind": "uml.actor",
      "name": "Payment gateway",
      "properties": {}
    },
    {
      "id": "shop",
      "kind": "uml.class",
      "name": "Online shop",
      "properties": {}
    },
    {
      "id": "checkout",
      "kind": "uml.use_case",
      "name": "Complete checkout",
      "properties": {
        "subject": [
          {
            "$ref": "shop"
          }
        ],
        "extensionPoint": [
          {
            "$ref": "loyalty-point"
          }
        ]
      }
    },
    {
      "id": "payment",
      "kind": "uml.use_case",
      "name": "Authorize payment",
      "properties": {
        "subject": [
          {
            "$ref": "shop"
          }
        ]
      }
    },
    {
      "id": "discount",
      "kind": "uml.use_case",
      "name": "Apply loyalty discount",
      "properties": {
        "subject": [
          {
            "$ref": "shop"
          }
        ]
      }
    },
    {
      "id": "receipt",
      "kind": "uml.use_case",
      "name": "Issue receipt",
      "properties": {
        "subject": [
          {
            "$ref": "shop"
          }
        ]
      }
    },
    {
      "id": "loyalty-point",
      "kind": "uml.extension_point",
      "name": "Before total calculation",
      "properties": {
        "useCase": {
          "$ref": "checkout"
        }
      }
    },
    {
      "id": "customer-checkout-actor",
      "kind": "uml.property",
      "name": "customer",
      "properties": {
        "type": {
          "$ref": "customer"
        }
      }
    },
    {
      "id": "customer-checkout-case",
      "kind": "uml.property",
      "name": "checkout",
      "properties": {
        "type": {
          "$ref": "checkout"
        }
      }
    },
    {
      "id": "gateway-payment-actor",
      "kind": "uml.property",
      "name": "gateway",
      "properties": {
        "type": {
          "$ref": "gateway"
        }
      }
    },
    {
      "id": "gateway-payment-case",
      "kind": "uml.property",
      "name": "payment",
      "properties": {
        "type": {
          "$ref": "payment"
        }
      }
    }
  ],
  "relations": [
    {
      "id": "owns-customer",
      "kind": "owns",
      "from": "root",
      "to": "customer"
    },
    {
      "id": "owns-member",
      "kind": "owns",
      "from": "root",
      "to": "member"
    },
    {
      "id": "owns-gateway",
      "kind": "owns",
      "from": "root",
      "to": "gateway"
    },
    {
      "id": "owns-shop",
      "kind": "owns",
      "from": "root",
      "to": "shop"
    },
    {
      "id": "owns-checkout",
      "kind": "owns",
      "from": "root",
      "to": "checkout"
    },
    {
      "id": "owns-payment",
      "kind": "owns",
      "from": "root",
      "to": "payment"
    },
    {
      "id": "owns-discount",
      "kind": "owns",
      "from": "root",
      "to": "discount"
    },
    {
      "id": "owns-receipt",
      "kind": "owns",
      "from": "root",
      "to": "receipt"
    },
    {
      "id": "owns-loyalty-point",
      "kind": "owns",
      "from": "checkout",
      "to": "loyalty-point"
    },
    {
      "id": "member-generalization",
      "kind": "uml.generalization",
      "from": "member",
      "to": "customer",
      "properties": {}
    },
    {
      "id": "checkout-payment",
      "kind": "uml.include",
      "from": "checkout",
      "to": "payment",
      "properties": {
        "includingCase": {
          "$ref": "checkout"
        },
        "addition": {
          "$ref": "payment"
        },
        "name": "Checkout payment"
      }
    },
    {
      "id": "owns-checkout-payment",
      "kind": "owns",
      "from": "checkout",
      "to": "checkout-payment"
    },
    {
      "id": "checkout-receipt",
      "kind": "uml.include",
      "from": "checkout",
      "to": "receipt",
      "properties": {
        "includingCase": {
          "$ref": "checkout"
        },
        "addition": {
          "$ref": "receipt"
        },
        "name": "Checkout receipt"
      }
    },
    {
      "id": "owns-checkout-receipt",
      "kind": "owns",
      "from": "checkout",
      "to": "checkout-receipt"
    },
    {
      "id": "discount-extension",
      "kind": "uml.extend",
      "from": "discount",
      "to": "checkout",
      "properties": {
        "extension": {
          "$ref": "discount"
        },
        "extendedCase": {
          "$ref": "checkout"
        },
        "extensionLocation": [
          {
            "$ref": "loyalty-point"
          }
        ],
        "name": "Discount extension"
      }
    },
    {
      "id": "owns-discount-extension",
      "kind": "owns",
      "from": "discount",
      "to": "discount-extension"
    },
    {
      "id": "customer-checkout",
      "kind": "uml.association",
      "from": "customer",
      "to": "checkout",
      "properties": {
        "memberEnd": [
          {
            "$ref": "customer-checkout-actor"
          },
          {
            "$ref": "customer-checkout-case"
          }
        ],
        "ownedEnd": [
          {
            "$ref": "customer-checkout-actor"
          },
          {
            "$ref": "customer-checkout-case"
          }
        ],
        "name": "Customer checkout",
        "sourceRole": "customer",
        "targetRole": "checkout"
      }
    },
    {
      "id": "owns-customer-checkout",
      "kind": "owns",
      "from": "root",
      "to": "customer-checkout"
    },
    {
      "id": "owns-customer-checkout-actor",
      "kind": "owns",
      "from": "customer-checkout",
      "to": "customer-checkout-actor"
    },
    {
      "id": "owns-customer-checkout-case",
      "kind": "owns",
      "from": "customer-checkout",
      "to": "customer-checkout-case"
    },
    {
      "id": "gateway-payment",
      "kind": "uml.association",
      "from": "gateway",
      "to": "payment",
      "properties": {
        "memberEnd": [
          {
            "$ref": "gateway-payment-actor"
          },
          {
            "$ref": "gateway-payment-case"
          }
        ],
        "ownedEnd": [
          {
            "$ref": "gateway-payment-actor"
          },
          {
            "$ref": "gateway-payment-case"
          }
        ],
        "name": "Gateway payment",
        "sourceRole": "gateway",
        "targetRole": "payment"
      }
    },
    {
      "id": "owns-gateway-payment",
      "kind": "owns",
      "from": "root",
      "to": "gateway-payment"
    },
    {
      "id": "owns-gateway-payment-actor",
      "kind": "owns",
      "from": "gateway-payment",
      "to": "gateway-payment-actor"
    },
    {
      "id": "owns-gateway-payment-case",
      "kind": "owns",
      "from": "gateway-payment",
      "to": "gateway-payment-case"
    }
  ],
