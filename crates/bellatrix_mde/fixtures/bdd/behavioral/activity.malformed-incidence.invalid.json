    {
      "id": "root",
      "kind": "uml.model",
      "name": "Behavioral acceptance corpus",
      "properties": {}
    },
    {
      "id": "fulfillment",
      "kind": "uml.activity",
      "name": "Fulfill order",
      "properties": {
        "isReadOnly": false
      }
    },
    {
      "id": "order",
      "kind": "uml.class",
      "name": "Order",
      "properties": {}
    },
    {
      "id": "start",
      "kind": "uml.initial_node",
      "name": "Start",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "receive",
      "kind": "uml.opaque_action",
      "name": "Receive order",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        },
        "outputValue": [
          {
            "$ref": "order-output"
          }
        ]
      }
    },
    {
      "id": "check",
      "kind": "uml.decision_node",
      "name": "Stock available?",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "parallel",
      "kind": "uml.fork_node",
      "name": "Prepare in parallel",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "reserve",
      "kind": "uml.opaque_action",
      "name": "Reserve stock",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        },
        "inPartition": [
          {
            "$ref": "warehouse"
          }
        ],
        "inputValue": [
          {
            "$ref": "order-input"
          }
        ]
      }
    },
    {
      "id": "charge",
      "kind": "uml.opaque_action",
      "name": "Charge customer",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "synchronize",
      "kind": "uml.join_node",
      "name": "Ready to ship",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "ship",
      "kind": "uml.opaque_action",
      "name": "Ship order",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        },
        "inPartition": [
          {
            "$ref": "warehouse"
          }
        ]
      }
    },
    {
      "id": "reject",
      "kind": "uml.opaque_action",
      "name": "Reject order",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "merge",
      "kind": "uml.merge_node",
      "name": "Finish either outcome",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "finish",
      "kind": "uml.activity_final_node",
      "name": "Completed",
      "properties": {
        "activity": {
          "$ref": "fulfillment"
        }
      }
    },
    {
      "id": "warehouse",
      "kind": "uml.activity_partition",
      "name": "Warehouse",
      "properties": {
        "node": [
          {
            "$ref": "reserve"
          },
          {
            "$ref": "ship"
          }
        ]
      }
    },
    {
      "id": "order-output",
      "kind": "uml.output_pin",
      "name": "order",
      "properties": {
        "type": {
          "$ref": "order"
        },
        "isUnique": false
      }
    },
    {
      "id": "order-input",
      "kind": "uml.input_pin",
      "name": "order",
      "properties": {
        "type": {
          "$ref": "order"
        },
        "isUnique": false
      }
    },
    {
      "id": "flow-3-guard",
      "kind": "uml.literal_boolean",
      "name": "Stock available",
      "properties": {
        "value": true,
        "visibility": null
      }
    },
    {
      "id": "flow-9-guard",
      "kind": "uml.literal_boolean",
      "name": "No stock",
      "properties": {
        "value": false,
        "visibility": null
      }
    },
    {
      "id": "uncertain-edge",
      "kind": "uml.object_flow",
