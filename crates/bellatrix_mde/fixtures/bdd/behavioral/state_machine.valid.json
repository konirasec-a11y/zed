{
  "schema_version": 1,
  "id": "state_machine-project",
  "name": "State Machine",
  "root_model": "root",
  "elements": [
    {
      "id": "root",
      "kind": "uml.model",
      "name": "Behavioral acceptance corpus",
      "properties": {}
    },
    {
      "id": "order-lifecycle",
      "kind": "uml.state_machine",
      "name": "Order lifecycle",
      "properties": {
        "region": [
          {
            "$ref": "main"
          }
        ]
      }
    },
    {
      "id": "main",
      "kind": "uml.region",
      "name": "Lifecycle",
      "properties": {
        "stateMachine": {
          "$ref": "order-lifecycle"
        }
      }
    },
    {
      "id": "initial",
      "kind": "uml.pseudostate",
      "name": "Initial",
      "properties": {
        "kind": "initial",
        "container": {
          "$ref": "main"
        }
      }
    },
    {
      "id": "pending",
      "kind": "uml.state",
      "name": "Pending",
      "properties": {
        "container": {
          "$ref": "main"
        }
      }
    },
    {
      "id": "processing",
      "kind": "uml.state",
      "name": "Processing",
      "properties": {
        "container": {
          "$ref": "main"
        },
        "region": [
          {
            "$ref": "processing-region"
          }
        ]
      }
    },
    {
      "id": "cancelled",
      "kind": "uml.state",
      "name": "Cancelled",
      "properties": {
        "container": {
          "$ref": "main"
        }
      }
    },
    {
      "id": "done",
      "kind": "uml.final_state",
      "name": "Done",
      "properties": {
        "container": {
          "$ref": "main"
        }
      }
    },
    {
      "id": "processing-region",
      "kind": "uml.region",
      "name": "Processing detail",
      "properties": {
        "state": {
          "$ref": "processing"
        }
      }
    },
    {
      "id": "detail-initial",
      "kind": "uml.pseudostate",
      "name": "Detail initial",
      "properties": {
        "kind": "initial",
        "container": {
          "$ref": "processing-region"
        }
      }
    },
    {
      "id": "packing",
      "kind": "uml.state",
      "name": "Packing",
      "properties": {
        "container": {
          "$ref": "processing-region"
        }
      }
    },
    {
      "id": "packed",
      "kind": "uml.final_state",
      "name": "Packed",
      "properties": {
        "container": {
          "$ref": "processing-region"
        }
      }
    }
  ],
  "relations": [
    {
      "id": "owns-order-lifecycle",
      "kind": "owns",
      "from": "root",
      "to": "order-lifecycle"
    },
    {
      "id": "owns-main",
      "kind": "owns",
      "from": "order-lifecycle",
      "to": "main"
    },
    {
      "id": "owns-initial",
      "kind": "owns",
      "from": "main",
      "to": "initial"
    },
    {
      "id": "owns-pending",
      "kind": "owns",
      "from": "main",
      "to": "pending"
    },
    {
      "id": "owns-processing",
      "kind": "owns",
      "from": "main",
      "to": "processing"
    },
    {
      "id": "owns-cancelled",
      "kind": "owns",
      "from": "main",
      "to": "cancelled"
    },
    {
      "id": "owns-done",
      "kind": "owns",
      "from": "main",
      "to": "done"
    },
    {
      "id": "owns-processing-region",
      "kind": "owns",
      "from": "processing",
      "to": "processing-region"
    },
    {
      "id": "owns-detail-initial",
      "kind": "owns",
      "from": "processing-region",
      "to": "detail-initial"
    },
    {
      "id": "owns-packing",
      "kind": "owns",
      "from": "processing-region",
      "to": "packing"
    },
    {
      "id": "owns-packed",
      "kind": "owns",
      "from": "processing-region",
      "to": "packed"
    },
    {
      "id": "begin",
      "kind": "uml.transition",
      "from": "initial",
      "to": "pending",
      "properties": {
        "source": {
          "$ref": "initial"
        },
        "target": {
          "$ref": "pending"
        },
        "container": {
          "$ref": "main"
        },
        "kind": "external",
        "name": "Begin"
      }
    },
    {
      "id": "owns-begin",
      "kind": "owns",
      "from": "main",
      "to": "begin"
    },
    {
      "id": "approve",
      "kind": "uml.transition",
      "from": "pending",
      "to": "processing",
      "properties": {
        "source": {
          "$ref": "pending"
        },
        "target": {
          "$ref": "processing"
        },
        "container": {
          "$ref": "main"
        },
        "kind": "external",
        "name": "Approve"
      }
    },
    {
      "id": "owns-approve",
      "kind": "owns",
      "from": "main",
      "to": "approve"
    },
    {
      "id": "cancel",
      "kind": "uml.transition",
      "from": "pending",
      "to": "cancelled",
      "properties": {
        "source": {
          "$ref": "pending"
        },
        "target": {
          "$ref": "cancelled"
        },
        "container": {
          "$ref": "main"
        },
        "kind": "external",
        "name": "Cancel"
      }
    },
    {
      "id": "owns-cancel",
      "kind": "owns",
      "from": "main",
      "to": "cancel"
    },
    {
      "id": "complete",
      "kind": "uml.transition",
      "from": "processing",
      "to": "done",
      "properties": {
        "source": {
          "$ref": "processing"
        },
        "target": {
          "$ref": "done"
        },
        "container": {
          "$ref": "main"
        },
        "kind": "external",
        "name": "Complete"
      }
    },
    {
      "id": "owns-complete",
      "kind": "owns",
      "from": "main",
      "to": "complete"
    },
    {
      "id": "close-cancelled",
      "kind": "uml.transition",
      "from": "cancelled",
      "to": "done",
      "properties": {
        "source": {
          "$ref": "cancelled"
        },
        "target": {
          "$ref": "done"
        },
        "container": {
          "$ref": "main"
        },
        "kind": "external",
        "name": "Close cancelled"
      }
    },
    {
      "id": "owns-close-cancelled",
      "kind": "owns",
      "from": "main",
      "to": "close-cancelled"
    },
    {
      "id": "start-packing",
      "kind": "uml.transition",
      "from": "detail-initial",
      "to": "packing",
      "properties": {
        "source": {
          "$ref": "detail-initial"
        },
        "target": {
          "$ref": "packing"
        },
        "container": {
          "$ref": "processing-region"
        },
        "kind": "external",
        "name": "Start packing"
      }
    },
    {
      "id": "owns-start-packing",
      "kind": "owns",
      "from": "processing-region",
      "to": "start-packing"
    },
    {
      "id": "finish-packing",
      "kind": "uml.transition",
      "from": "packing",
      "to": "packed",
      "properties": {
        "source": {
          "$ref": "packing"
        },
        "target": {
          "$ref": "packed"
        },
        "container": {
          "$ref": "processing-region"
        },
        "kind": "external",
        "name": "Finish packing"
      }
    },
    {
      "id": "owns-finish-packing",
      "kind": "owns",
      "from": "processing-region",
      "to": "finish-packing"
    }
